    given-names: "Rolando"
    orcid: "https://orcid.org/0009-0005-4896-1112"
    affiliation: "Hermes Labs"
license: MIT
version: "0.3.1"
repository-code: "https://github.com/hermes-labs-ai/csv-quality-gate"
keywords:
